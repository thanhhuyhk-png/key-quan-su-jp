{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.*)",
      "Read(./**/.env.*)",
      "Read(./cookies/**)",
      "Read(./**/*key*)",
      "Read(./**/*secret*)",
      "Read(./**/*token*)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./.env.*)",
      "Edit(./**/.env.*)",
      "Edit(./cookies/**)",
      "Edit(./**/*key*)",
      "Edit(./**/*secret*)",
      "Edit(./**/*token*)",
      "Write(./.env)",
      "Write(./**/.env)",
      "Write(./cookies/**)",
      "Write(./**/*key*)",
      "Write(./**/*secret*)",
      "Write(./**/*token*)",
      "Bash(cat .env:*)",
      "Bash(cat ./.env:*)",
      "Bash(cat */.env:*)",
      "Bash(type .env:*)",
      "Bash(type .\\.env:*)",
      "Bash(more .env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(grep * .env:*)",
      "Bash(cat cookies/*:*)",
      "Bash(type cookies*:*)",
      "Bash(cat *key*:*)",
      "Bash(cat *secret*:*)",
      "Bash(cat *token*:*)",
      "Bash(type *key*:*)",
      "Bash(type *secret*:*)",
      "Bash(type *token*:*)",
      "Bash(Get-Content *.env*:*)",
      "Bash(Get-Content *cookies*:*)"
    ]
  }
}
